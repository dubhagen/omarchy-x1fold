#!/usr/bin/env python3
"""ThinkPad X1 Fold 16 posture control for Omarchy/Hyprland.

Commands:
  status
  rotate 0|90|180|270|normal|left|right|inverted|cycle|portrait|portrait-flip|landscape|landscape-flip
  clamshell on|off|toggle
  autorotate on|off|toggle
  autoclamshell on|off|toggle
  osk on|off|toggle
  cover-ratio <0.35-0.70>
  overlap <pixels>
  tablet               full panel (clamshell off)
  apply
  constrain-fullscreen [address]
  constrain-screensaver [address]
  dismiss-screensaver
  fullscreen toggle|on|off [address]
  sync-bar
  cursor hide|show
  daemon
"""

from __future__ import annotations

import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import time
from contextlib import contextmanager
from pathlib import Path

PLUGIN_ID = "mattd.x1fold"
HOME = Path(os.environ.get("HOME", str(Path.home())))
STATE_DIR = HOME / ".local" / "state" / "omarchy" / "x1fold"
STATE_PATH = STATE_DIR / "state.json"
STATE_LOCK = STATE_DIR / "state.lock"
MONITORS_LUA = Path(os.environ.get("OMARCHY_MONITORS_LUA", HOME / ".config" / "hypr" / "monitors.lua"))
BEGIN_MARK = "-- mattd.x1fold: begin"
END_MARK = "-- mattd.x1fold: end"
ARRANGE_BEGIN = "-- omarchy-monitor-arrange: begin"
INTERNAL_RE = re.compile(r"^(eDP|LVDS|DSI)-")
FALLBACK_DIGITIZERS = (
    "wacom-hid-52ba-finger",
    "wacom-hid-52ba-pen",
)
SCREENSAVER_CLASS = "org.omarchy.screensaver"
BAR_OFF_FLAG = HOME / ".local" / "state" / "omarchy" / "toggles" / "bar-off"
BAR_HIDDEN_MARKER = STATE_DIR / "bar-hidden-by-plugin"
FS_PLACING_LOCK = STATE_DIR / "fs-placing.lock"
FS_LAYOUT_PATH = STATE_DIR / "fs-layout.json"

ORIENTATIONS = {
    0: {"name": "portrait", "degrees": 0, "label": "Portrait"},
    1: {"name": "landscape-flip", "degrees": 90, "label": "Landscape (flipped)"},
    2: {"name": "portrait-flip", "degrees": 180, "label": "Portrait (flipped)"},
    3: {"name": "landscape", "degrees": 270, "label": "Landscape"},
}
NAME_TO_TRANSFORM = {
    "0": 0, "90": 1, "180": 2, "270": 3,
    "normal": 0, "right": 1, "inverted": 2, "left": 3,
    "portrait": 0, "landscape-flip": 1, "portrait-flip": 2, "landscape": 3,
}

# Landscape was calibrated on this chassis as gravity along -X → transform 3.
# Portrait auto-rotate was upside-down in both directions, so Y is swapped
# relative to the first mapping.
ACCEL_MAP = {
    ("x", 1): 1,
    ("x", -1): 3,
    ("y", 1): 2,
    ("y", -1): 0,
}

DEFAULT_STATE = {
    "transform": 3,
    "clamshell": False,
    "autorotate": False,
    "autoclamshell": False,
    "cover_ratio": 0.50,
    "overlap_px": 0,
    "osk": False,
    "monitor_desc": "",
}


def fail(msg: str, code: int = 1) -> None:
    print(f"x1fold: {msg}", file=sys.stderr)
    raise SystemExit(code)


def run(cmd: list[str], check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, check=check, capture_output=True, text=True)


def notify(title: str, body: str) -> None:
    for cmd in (
        ["omarchy-notification-send", "-u", "low", title, body],
        ["notify-send", "-u", "low", title, body],
    ):
        if shutil.which(cmd[0]):
            subprocess.run(cmd, check=False, capture_output=True)
            return


def osd(message: str, icon: str = "󰁑") -> None:
    payload = json.dumps({"icon": icon, "message": message, "duration": 1400})
    subprocess.run(
        ["omarchy-shell", "-q", "osd", "show", payload],
        check=False,
        capture_output=True,
    )


def load_state() -> dict:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    state = dict(DEFAULT_STATE)
    if STATE_PATH.exists():
        try:
            data = json.loads(STATE_PATH.read_text())
            if isinstance(data, dict):
                state.update(data)
        except json.JSONDecodeError:
            pass
    state["transform"] = int(state.get("transform", 3)) % 4
    state["clamshell"] = bool(state.get("clamshell"))
    state["autorotate"] = bool(state.get("autorotate"))
    state["autoclamshell"] = bool(state.get("autoclamshell"))
    state["osk"] = bool(state.get("osk"))
    try:
        ratio = float(state.get("cover_ratio", 0.50))
    except (TypeError, ValueError):
        ratio = 0.50
    state["cover_ratio"] = min(0.70, max(0.35, ratio))
    try:
        overlap = int(float(state["overlap_px"])) if "overlap_px" in state else 0
    except (TypeError, ValueError):
        overlap = 0
    overlap = int(round(overlap / 5.0) * 5)
    state["overlap_px"] = min(50, max(-50, overlap))
    return state


def save_state(state: dict) -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    payload = json.dumps(state, indent=2) + "\n"
    if STATE_PATH.exists() and STATE_PATH.read_text() == payload:
        return
    tmp = STATE_PATH.with_suffix(".json.tmp")
    tmp.write_text(payload)
    tmp.replace(STATE_PATH)


@contextmanager
def locked_state():
    """Serialize load-mutate-apply so the daemon cannot overwrite a live command."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with STATE_LOCK.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield load_state()


def run_locked(fn, *args):
    with locked_state() as state:
        return fn(state, *args)


def hypr_monitors() -> list[dict]:
    try:
        out = run(["hyprctl", "monitors", "-j"]).stdout
    except (subprocess.CalledProcessError, FileNotFoundError) as exc:
        fail(f"hyprctl monitors failed: {exc}")
    try:
        monitors = json.loads(out)
    except json.JSONDecodeError:
        fail("hyprctl monitors returned invalid JSON")
    return [m for m in monitors if not m.get("disabled")]


def is_internal(mon: dict) -> bool:
    return bool(INTERNAL_RE.match(str(mon.get("name") or "")))


def pick_monitor(state: dict) -> dict:
    monitors = hypr_monitors()
    if not monitors:
        fail("no enabled monitors")
    desc = state.get("monitor_desc") or ""
    if desc:
        for mon in monitors:
            if mon.get("description") == desc:
                return mon
    for mon in monitors:
        if is_internal(mon):
            return mon
    for mon in monitors:
        if mon.get("focused"):
            return mon
    return monitors[0]


def logical_size(mon: dict, transform: int) -> tuple[int, int]:
    width = float(mon["width"])
    height = float(mon["height"])
    scale = float(mon.get("scale") or 1) or 1
    if transform % 2 == 1:
        return round(height / scale), round(width / scale)
    return round(width / scale), round(height / scale)


def is_portrait(transform: int) -> bool:
    return transform % 2 == 0


def lua_escape(value: str) -> str:
    return value.replace("\\", "\\\\").replace('"', '\\"')


def monitor_lua(mon: dict, transform: int, reserved_bottom: int) -> str:
    desc = lua_escape(str(mon.get("description") or mon.get("name")))
    width = int(mon["width"])
    height = int(mon["height"])
    refresh = float(mon.get("refreshRate") or 60)
    x = int(mon.get("x") or 0)
    y = int(mon.get("y") or 0)
    scale = float(mon.get("scale") or 1)
    vrr = 1 if mon.get("vrr") else 0
    reserved = (
        f"reserved_area = {{ top = 0, bottom = {int(reserved_bottom)}, left = 0, right = 0 }}"
        if reserved_bottom
        else "reserved_area = 0"
    )
    return (
        f'hl.monitor({{ output = "desc:{desc}", mode = "{width}x{height}@{refresh:g}", '
        f'position = "{x}x{y}", scale = {scale:g}, transform = {int(transform)}, '
        f"vrr = {vrr}, {reserved} }})"
    )


def hypr_digitizer_names() -> list[str]:
    """Touchscreens and tablet pens. Not the folio keyboard touchpad."""
    names: list[str] = []
    try:
        data = json.loads(run(["hyprctl", "devices", "-j"], check=False).stdout or "{}")
    except (json.JSONDecodeError, FileNotFoundError):
        data = {}
    if not isinstance(data, dict):
        data = {}
    for key in ("touch", "tablets"):
        for dev in data.get(key) or []:
            if not isinstance(dev, dict):
                continue
            name = str(dev.get("name") or "").strip()
            if name and name not in names:
                names.append(name)
    return names or list(FALLBACK_DIGITIZERS)


def touch_lua(transform: int, output: str) -> str:
    """Keep Wacom finger/pen mapped to the OLED rotation.

    Hyprland's default input:touchdevice:transform is 0, not "follow the
    monitor", so a landscape panel still sees taps in native portrait space.

    Do not bind output. Mapping the digitizer to eDP-1 puts taps in the
    usable layout box (minus bar/OSK exclusive zones). The bar then gets
    no touches, and OSK taps land on the window. Leave output Auto.

    Do not write transform 0. An explicit 0 is "set" and replaces the live
    libinput matrix with identity. This panel has no udev calibration
    matrix; once that live matrix is replaced, hyprctl reload cannot
    restore the native mapping and the bar misses taps. Recreating the
    Wacom HID (i2c-WACF2200:00 unbind/rebind) does. Only write a transform
    when the OLED is actually rotated.
    """
    t = int(transform) % 8
    _ = output
    if t == 0:
        return ""
    lines = [
        "hl.config({ input = { "
        f"touchdevice = {{ transform = {t} }}, "
        f"tablet = {{ transform = {t} }} "
        "} })"
    ]
    for name in hypr_digitizer_names():
        n = lua_escape(name)
        lines.append(f'hl.device({{ name = "{n}", transform = {t} }})')
    return "\n".join(lines)


def eval_monitor(lua: str) -> None:
    try:
        proc = run(["hyprctl", "eval", lua], check=False)
    except FileNotFoundError:
        fail("hyprctl not found")
    if proc.returncode != 0:
        err = (proc.stderr or proc.stdout or "").strip()
        fail(f"hyprctl eval failed: {err or lua}")


def persist_lua(lua: str) -> None:
    MONITORS_LUA.parent.mkdir(parents=True, exist_ok=True)
    text = MONITORS_LUA.read_text() if MONITORS_LUA.exists() else ""
    block = f"{BEGIN_MARK}\n{lua}\n{END_MARK}\n"
    pattern = re.compile(re.escape(BEGIN_MARK) + r".*?" + re.escape(END_MARK) + r"\n?", re.S)
    if pattern.search(text):
        updated = pattern.sub(block, text, count=1)
    else:
        updated = text
        if updated and not updated.endswith("\n"):
            updated += "\n"
        updated += "\n" + block
    if updated != text:
        MONITORS_LUA.write_text(updated)


def sync_arrange_transform(mon: dict, transform: int) -> None:
    if not MONITORS_LUA.exists():
        return
    text = MONITORS_LUA.read_text()
    desc = re.escape(str(mon.get("description") or ""))
    if not desc or ARRANGE_BEGIN not in text:
        return
    updated, n = re.subn(
        rf'(output = "desc:{desc}".*?transform = )\d+',
        rf"\g<1>{int(transform)}",
        text,
        count=1,
        flags=re.S,
    )
    if n and updated != text:
        MONITORS_LUA.write_text(updated)


def eval_screensaver_rule(state: dict, mon: dict, bottom: int) -> None:
    """Clamshell: map the screensaver already sized to the visible half.

    Outside clamshell, restore Omarchy's stock covering-fullscreen + slide.
    """
    clamshell = bool(state.get("clamshell"))
    if clamshell:
        lw, lh = logical_size(mon, int(state.get("transform") or 0) % 4)
        w, h = lw + 2, max(1, lh - int(bottom))
        extra = (
            "no_anim = true, float = true, fullscreen = false, "
            f"size = {{ {w}, {h} }}, move = {{ -1, 0 }}"
        )
    else:
        extra = 'float = true, fullscreen = true, animation = "slide"'
    lua = (
        "hl.window_rule({ "
        'name = "mattd.x1fold-screensaver", '
        'match = { class = "org.omarchy.screensaver" }, '
        "decorate = false, rounding = 0, no_shadow = true, border_size = 0, "
        "no_max_size = true, "
        f"{extra} }})"
    )
    try:
        run(["hyprctl", "eval", lua], check=False)
    except FileNotFoundError:
        pass


def reserved_bottom(mon: dict, transform: int, clamshell: bool, ratio: float, overlap: int) -> int:
    if not clamshell or not is_portrait(transform):
        return 0
    _lw, lh = logical_size(mon, transform)
    return max(0, round(lh * ratio) + int(overlap))


def apply(state: dict, quiet: bool = False) -> dict:
    mon = pick_monitor(state)
    state["monitor_desc"] = mon.get("description") or ""
    transform = int(state["transform"]) % 4
    clamshell = bool(state["clamshell"])
    if clamshell and not is_portrait(transform):
        transform = 0
        state["transform"] = transform
    bottom = reserved_bottom(
        mon, transform, clamshell, float(state["cover_ratio"]), int(state["overlap_px"])
    )
    lua = monitor_lua(mon, transform, bottom)
    touch = touch_lua(transform, str(mon.get("name") or "eDP-1"))
    eval_monitor(lua)
    if touch:
        eval_lua(touch)
    old_lua = MONITORS_LUA.read_text() if MONITORS_LUA.exists() else ""
    body = lua + (("\n" + touch) if touch else "")
    persist_lua(body)
    # Returning to native portrait drops the touchdevice block. Reload so
    # Hyprland unsets the rotated calibration. Do not write transform=0
    # instead: that stays "set" and poisons the live matrix.
    if "touchdevice" in old_lua and "touchdevice" not in body:
        run(["hyprctl", "reload"], check=False)
    sync_arrange_transform(mon, transform)
    eval_screensaver_rule(state, mon, bottom)
    save_state(state)
    if clamshell:
        set_osk(False, persist=False)
        state["osk"] = False
        save_state(state)
    elif screensaver_running():
        hide_osk_surface()
    elif state.get("osk"):
        show_osk_surface()
    constrain_fullscreen(state)
    sync_bar(state)
    if not quiet:
        announce(state)
    return state


def hypr_clients() -> list[dict]:
    try:
        out = run(["hyprctl", "clients", "-j"], check=False).stdout or "[]"
        data = json.loads(out)
    except (json.JSONDecodeError, FileNotFoundError):
        return []
    return data if isinstance(data, list) else []


def dispatch_lua(lua: str) -> None:
    try:
        run(["hyprctl", "dispatch", lua], check=False)
    except FileNotFoundError:
        pass


def eval_lua(lua: str) -> None:
    try:
        run(["hyprctl", "eval", lua], check=False)
    except FileNotFoundError:
        pass


def window_selector(address: str) -> str:
    addr = str(address)
    return addr if addr.startswith("address:") else f"address:{addr}"


def dispatch_fullscreen_state(address: str, internal: int, client: int) -> None:
    sel = window_selector(address)
    dispatch_lua(
        f'hl.dsp.window.fullscreen_state({{ internal = {int(internal)}, '
        f'client = {int(client)}, action = "set", window = "{sel}" }})'
    )


def set_window_prop(address: str, prop: str, value: str) -> None:
    sel = window_selector(address)
    dispatch_lua(
        f'hl.dsp.window.set_prop({{ prop = "{prop}", value = "{value}", window = "{sel}" }})'
    )


def is_screensaver(client: dict) -> bool:
    return str(client.get("class") or "") == SCREENSAVER_CLASS


CURSOR_RESTORE_PATH = STATE_DIR / "cursor-restore.json"


def hypr_option(name: str) -> dict:
    try:
        out = run(["hyprctl", "getoption", name, "-j"], check=False).stdout or "{}"
        data = json.loads(out)
        return data if isinstance(data, dict) else {}
    except (json.JSONDecodeError, FileNotFoundError):
        return {}


def eval_cursor(**kwargs: object) -> None:
    parts = []
    if "invisible" in kwargs:
        parts.append(f"invisible = {str(bool(kwargs['invisible'])).lower()}")
    if "no_hardware_cursors" in kwargs:
        parts.append(f"no_hardware_cursors = {int(kwargs['no_hardware_cursors'])}")
    if not parts:
        return
    inner = ", ".join(parts)
    try:
        run(["hyprctl", "eval", f"hl.config({{ cursor = {{ {inner} }} }})"], check=False)
    except FileNotFoundError:
        pass


def hide_cursor_for_screensaver() -> None:
    if not CURSOR_RESTORE_PATH.exists():
        hw = hypr_option("cursor:no_hardware_cursors")
        CURSOR_RESTORE_PATH.parent.mkdir(parents=True, exist_ok=True)
        CURSOR_RESTORE_PATH.write_text(
            json.dumps({"no_hardware_cursors": int(hw.get("int") or hw.get("data") or 0)})
            + "\n"
        )
    eval_cursor(invisible=True, no_hardware_cursors=1)


def restore_cursor_after_screensaver() -> None:
    hw = 0
    if CURSOR_RESTORE_PATH.exists():
        try:
            loaded = json.loads(CURSOR_RESTORE_PATH.read_text())
            if isinstance(loaded, dict):
                hw = int(loaded.get("no_hardware_cursors") or 0)
        except json.JSONDecodeError:
            pass
        CURSOR_RESTORE_PATH.unlink(missing_ok=True)
    eval_cursor(invisible=False, no_hardware_cursors=hw)


def usable_rect(mon: dict, state: dict) -> tuple[int, int, int, int]:
    """Visible OLED half. -1/+2 covers a 1px scale-rounding gap on the left."""
    transform = int(state.get("transform") or 0) % 4
    lw, lh = logical_size(mon, transform)
    bottom = reserved_bottom(
        mon,
        transform,
        True,
        float(state.get("cover_ratio") or 0.50),
        int(state.get("overlap_px") or 0),
    )
    x = int(mon.get("x") or 0) - 1
    y = int(mon.get("y") or 0)
    return x, y, lw + 2, max(1, lh - bottom)


def screensaver_rect(mon: dict, state: dict) -> tuple[int, int, int, int]:
    return usable_rect(mon, state)


def usable_geometry_ok(cur: dict, x: int, y: int, w: int, h: int) -> bool:
    at = cur.get("at") or [0, 0]
    size = cur.get("size") or [0, 0]
    return (
        bool(cur.get("floating"))
        and int(cur.get("fullscreen") or 0) != 2
        and abs(int(at[0]) - x) <= 2
        and abs(int(at[1]) - y) <= 2
        and abs(int(size[0]) - w) <= 4
        and abs(int(size[1]) - h) <= 4
    )


def default_border_size() -> int:
    opt = hypr_option("general:border_size")
    try:
        return int(opt.get("int") or 2)
    except (TypeError, ValueError):
        return 2


def animations_enabled() -> bool:
    opt = hypr_option("animations:enabled")
    if "bool" in opt:
        return bool(opt.get("bool"))
    try:
        return bool(int(opt.get("int") or 1))
    except (TypeError, ValueError):
        return True


def set_animations_enabled(enabled: bool) -> None:
    eval_lua(
        "hl.config({ animations = { enabled = " + ("true" if enabled else "false") + " } })"
    )


def bar_parked() -> bool:
    try:
        data = json.loads(run(["hyprctl", "layers", "-j"], check=False).stdout or "{}")
    except (json.JSONDecodeError, FileNotFoundError):
        return False
    if not isinstance(data, dict):
        return False
    for md in data.values():
        if not isinstance(md, dict):
            continue
        for ls in (md.get("levels") or {}).values():
            for layer in ls or []:
                ns = str((layer or {}).get("namespace") or "")
                if "bar" in ns.lower():
                    return int(layer.get("y") or 0) < 0
    return False


def wait_bar_unparked(timeout: float = 0.45) -> None:
    deadline = time.time() + timeout
    while time.time() < deadline:
        if not bar_parked():
            return
        time.sleep(0.02)


def force_unpark_bar() -> None:
    """Show the bar even while the screensaver is still mapped.

    sync_bar() would keep it hidden because the saver counts as a clamshell
    overlay. Dismiss needs the exclusive zone applied before the saver dies.
    """
    BAR_HIDDEN_MARKER.unlink(missing_ok=True)
    BAR_OFF_FLAG.unlink(missing_ok=True)


def close_screensaver_windows() -> None:
    for client in hypr_clients():
        if not is_screensaver(client):
            continue
        addr = str(client.get("address") or "")
        if not addr:
            continue
        sel = window_selector(addr)
        dispatch_lua(f'hl.dsp.window.close({{ window = "{sel}" }})')


def wait_screensaver_gone(timeout: float = 0.4) -> None:
    deadline = time.time() + timeout
    while time.time() < deadline:
        if not screensaver_running():
            return
        time.sleep(0.02)


def restore_window_chrome(addr: str) -> None:
    """Undo fullscreen set_prop so the active-window border comes back."""
    sel = window_selector(addr)
    border = default_border_size()
    eval_lua(
        "local win = \"" + sel + "\"\n"
        f'hl.dispatch(hl.dsp.window.set_prop({{ prop = "border_size", value = "{border}", window = win }}))\n'
        'hl.dispatch(hl.dsp.window.set_prop({ prop = "no_anim", value = "0", window = win }))\n'
        'hl.dispatch(hl.dsp.window.set_prop({ prop = "rounding", value = "0", window = win }))\n'
    )


def float_to_usable_half(
    client: dict, state: dict, *, client_fullscreen: bool = False
) -> bool:
    """Size a floating window to the visible OLED half in one compositor eval."""
    addr = str(client.get("address") or "")
    if not addr:
        return False
    try:
        mon = pick_monitor(state)
    except SystemExit:
        return False
    x, y, w, h = usable_rect(mon, state)
    sel = window_selector(addr)
    if usable_geometry_ok(client, x, y, w, h):
        return True
    drop_fs = int(client.get("fullscreen") or 0) in {1, 2}
    lua = (
        "local win = \"" + sel + "\"\n"
        'hl.dispatch(hl.dsp.window.set_prop({ prop = "sync_fullscreen", value = "0", window = win }))\n'
        'hl.dispatch(hl.dsp.window.float({ action = "set", window = win }))\n'
    )
    if drop_fs or client_fullscreen:
        lua += (
            "hl.dispatch(hl.dsp.window.fullscreen_state("
            '{ internal = 0, client = 2, action = "set", window = win }))\n'
            'hl.dispatch(hl.dsp.window.float({ action = "set", window = win }))\n'
        )
    lua += (
        f"hl.dispatch(hl.dsp.window.move({{ x = {x}, y = {y}, relative = false, window = win }}))\n"
        f"hl.dispatch(hl.dsp.window.resize({{ x = {w}, y = {h}, relative = false, window = win }}))\n"
    )
    eval_lua(lua)
    cur = _client_by_addr(addr) or client
    if not cur.get("floating"):
        dispatch_lua(f'hl.dsp.window.float({{ action = "set", window = "{sel}" }})')
        cur = _client_by_addr(addr) or cur
    return usable_geometry_ok(cur, x, y, w, h)


def _client_by_addr(addr: str) -> dict | None:
    want = addr.lower().replace("address:", "")
    for client in hypr_clients():
        got = str(client.get("address") or "").lower().replace("address:", "")
        if got == want:
            return client
    return None


def place_screensaver(client: dict, state: dict) -> bool:
    """Float + shrink after map so TTE measures the visible half.

    Wayland fullscreen is always the whole output; reserved_area is ignored.
    A floating window does not join dwindle, so other clients keep their size.
    ttfx samples the pty once; after a successful resize, restart it.
    """
    try:
        mon = pick_monitor(state)
    except SystemExit:
        return False
    x, y, w, h = usable_rect(mon, state)
    already = usable_geometry_ok(client, x, y, w, h)
    placed = float_to_usable_half(client, state)
    hide_cursor_for_screensaver()
    if placed and not already:
        # ttfx already measured the fullscreen pty; restart so it uses half size.
        run(["pkill", "-x", "ttfx"], check=False)
    return placed


def client_tags(client: dict) -> list[str]:
    tags = client.get("tags") or []
    if isinstance(tags, str):
        return [tags]
    return [str(t) for t in tags] if isinstance(tags, list) else []


def clamshell_fs_live(client: dict) -> bool:
    """True only while our half-panel overlay (or covering-fs) is actually up."""
    if is_screensaver(client):
        return True
    if int(client.get("fullscreen") or 0) == 2:
        return True
    tags = client_tags(client)
    if "x1fold-clamshell-fs" in tags and client.get("floating"):
        return True
    return False


def cleanup_stale_clamshell_fs(client: dict) -> None:
    """Drop leftover tags/client-fs on windows that are tiled again."""
    if is_screensaver(client) or clamshell_fs_live(client):
        return
    tags = client_tags(client)
    stale_tag = "x1fold-clamshell-fs" in tags or "x1fold-was-tiled" in tags
    stale_client = int(client.get("fullscreenClient") or 0) == 2 and not client.get("floating")
    if not stale_tag and not stale_client:
        return
    addr = str(client.get("address") or "")
    if not addr:
        return
    if stale_client:
        dispatch_fullscreen_state(addr, 0, 0)
    if stale_tag:
        tag_window(addr, "-x1fold-was-tiled")
        tag_window(addr, "-x1fold-clamshell-fs")
    restore_window_chrome(addr)


def fullscreen_needs_bar_hidden(state: dict) -> bool:
    """Park the bar only while a real clamshell fullscreen overlay is up.

    A tiled window can keep fullscreenClient=2 after YouTube/Super+F exit;
    that must not keep the bar hidden.
    """
    if not bool(state.get("clamshell")):
        return False
    return any(clamshell_fs_live(client) for client in hypr_clients())


def sync_bar(state: dict) -> bool:
    """Park the Omarchy bar during clamshell fullscreen; restore if we hid it.

    Uses the same `bar-off` flag as `omarchy toggle bar`. If the user already
    hid the bar, leave it. Covering-fullscreen on the full panel hides the
    bar; maximize-inside-the-half does not, so we park it ourselves.
    """
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    lock_path = STATE_DIR / "bar-sync.lock"
    with lock_path.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        for client in hypr_clients():
            cleanup_stale_clamshell_fs(client)
            if (
                not clamshell_fs_live(client)
                and not client.get("floating")
                and client.get("address")
            ):
                restore_window_chrome(str(client.get("address")))
        want_hidden = fullscreen_needs_bar_hidden(state)
        ours = BAR_HIDDEN_MARKER.exists()
        flag = BAR_OFF_FLAG.exists()
        if want_hidden:
            if flag and not ours:
                return True
            BAR_OFF_FLAG.parent.mkdir(parents=True, exist_ok=True)
            BAR_OFF_FLAG.touch()
            BAR_HIDDEN_MARKER.write_text("1\n")
            return True
        if ours:
            BAR_HIDDEN_MARKER.unlink(missing_ok=True)
            BAR_OFF_FLAG.unlink(missing_ok=True)
        return False


def constrain_screensaver(state: dict, address: str | None = None) -> bool:
    if not bool(state.get("clamshell")):
        return True
    lock_path = STATE_DIR / "screensaver.lock"
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with lock_path.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        want = str(address or "").lower().replace("address:", "")
        found = False
        placed = True
        for client in hypr_clients():
            if not is_screensaver(client):
                continue
            addr = str(client.get("address") or "")
            if want and addr.lower().replace("address:", "") != want:
                continue
            found = True
            if not place_screensaver(client, state):
                placed = False
        return found and placed


def tag_window(address: str, tag: str) -> None:
    sel = window_selector(address)
    dispatch_lua(f'hl.dsp.window.tag({{ tag = "{tag}", window = "{sel}" }})')


def placing_begin() -> None:
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    FS_PLACING_LOCK.write_text("1\n")


def placing_end() -> None:
    FS_PLACING_LOCK.unlink(missing_ok=True)


def addr_key(address: str) -> str:
    return str(address or "").lower().replace("address:", "")


def workspace_id(client: dict) -> int | None:
    ws = client.get("workspace")
    if isinstance(ws, dict):
        try:
            return int(ws.get("id"))
        except (TypeError, ValueError):
            return None
    return None


def tiled_on_workspace(ws: int | None) -> list[dict]:
    out: list[dict] = []
    if ws is None:
        return out
    for client in hypr_clients():
        if client.get("floating"):
            continue
        if workspace_id(client) != ws:
            continue
        out.append(client)
    out.sort(
        key=lambda c: (
            int((c.get("at") or [0, 0])[1]),
            int((c.get("at") or [0, 0])[0]),
        )
    )
    return out


def split_hint(client: dict, tiled: list[dict]) -> str | None:
    want = addr_key(str(client.get("address") or ""))
    others = [c for c in tiled if addr_key(str(c.get("address") or "")) != want]
    if not others:
        return None
    tx, ty = (client.get("at") or [0, 0])[:2]
    ox = min(int((c.get("at") or [0, 0])[0]) for c in others)
    oy = min(int((c.get("at") or [0, 0])[1]) for c in others)
    dx = int(tx) - ox
    dy = int(ty) - oy
    if abs(dx) >= abs(dy):
        return "l" if dx < 0 else "r"
    return "u" if dy < 0 else "d"


def save_tile_layout(client: dict) -> None:
    ws = workspace_id(client)
    tiled = tiled_on_workspace(ws)
    payload = {
        "address": client.get("address"),
        "workspace": ws,
        "order": [c.get("address") for c in tiled],
        "hint": split_hint(client, tiled),
    }
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    FS_LAYOUT_PATH.write_text(json.dumps(payload) + "\n")


def wait_client(addr: str, pred, timeout: float = 0.6) -> dict | None:
    deadline = time.time() + timeout
    last = None
    while time.time() < deadline:
        last = _client_by_addr(addr)
        if last and pred(last):
            return last
        time.sleep(0.03)
    return last or _client_by_addr(addr)


def set_window_tiled(addr: str) -> bool:
    sel = window_selector(addr)
    for action in ("off", "disable"):
        dispatch_lua(f'hl.dsp.window.float({{ action = "{action}", window = "{sel}" }})')
        cur = wait_client(addr, lambda c: not c.get("floating"), 0.35)
        if cur and not cur.get("floating"):
            return True
    return False


def restore_tile_order(addr: str) -> None:
    if not FS_LAYOUT_PATH.exists():
        return
    try:
        data = json.loads(FS_LAYOUT_PATH.read_text())
    except json.JSONDecodeError:
        return
    desired = [addr_key(a) for a in (data.get("order") or []) if a]
    if not desired:
        return
    ws = data.get("workspace")
    sel = window_selector(addr)
    want = addr_key(addr)
    for _ in range(max(4, len(desired))):
        current = [addr_key(str(c.get("address") or "")) for c in tiled_on_workspace(ws)]
        if want not in current or want not in desired:
            return
        got_i = current.index(want)
        want_i = desired.index(want)
        if got_i == want_i:
            return
        other = current[want_i]
        dispatch_lua(f'hl.dsp.focus({{ window = "{sel}" }})')
        dispatch_lua(
            f'hl.dsp.window.swap({{ target = "{window_selector(other)}" }})'
        )


def is_clamshell_fs(client: dict) -> bool:
    if is_screensaver(client):
        return False
    if clamshell_fs_live(client):
        return True
    tags = client_tags(client)
    return "x1fold-clamshell-fs" in tags and bool(client.get("floating"))


def hypr_active_client() -> dict | None:
    try:
        out = run(["hyprctl", "activewindow", "-j"], check=False).stdout or "{}"
        data = json.loads(out)
    except (json.JSONDecodeError, FileNotFoundError):
        return None
    return data if isinstance(data, dict) and data.get("address") else None


def restore_tiled_after_clamshell_fs(client: dict) -> None:
    addr = str(client.get("address") or "")
    if not addr:
        return
    tags = client_tags(client)
    was_tiled = "x1fold-was-tiled" in tags
    recover = bool(client.get("floating")) and (
        int(client.get("fullscreenClient") or 0) == 2
        or "x1fold-clamshell-fs" in tags
    )
    hint = None
    ws = None
    if FS_LAYOUT_PATH.exists():
        try:
            saved = json.loads(FS_LAYOUT_PATH.read_text())
            if addr_key(str(saved.get("address") or "")) == addr_key(addr):
                hint = saved.get("hint")
                ws = saved.get("workspace")
        except json.JSONDecodeError:
            pass
    leftovers = tiled_on_workspace(ws if ws is not None else workspace_id(client))
    pre = ""
    if leftovers and (was_tiled or recover) and hint in {"l", "r", "u", "d"}:
        other = window_selector(str(leftovers[0].get("address") or ""))
        pre = (
            f'hl.dispatch(hl.dsp.focus({{ window = "{other}" }}))\n'
            f'hl.dispatch(hl.dsp.layout("preselect {hint}"))\n'
        )
    sel = window_selector(addr)
    border = default_border_size()
    eval_lua(
        pre
        + "local win = \"" + sel + "\"\n"
        "hl.dispatch(hl.dsp.window.fullscreen_state("
        '{ internal = 0, client = 0, action = "set", window = win }))\n'
        + (
            'hl.dispatch(hl.dsp.window.float({ action = "off", window = win }))\n'
            if (was_tiled or recover)
            else ""
        )
        + f'hl.dispatch(hl.dsp.window.set_prop({{ prop = "border_size", value = "{border}", window = win }}))\n'
    )
    tiled_ok = True
    if was_tiled or recover:
        tiled_ok = bool(
            wait_client(addr, lambda c: not c.get("floating"), 0.45)
            and not (_client_by_addr(addr) or {}).get("floating")
        )
        if not tiled_ok:
            tiled_ok = set_window_tiled(addr)
        if tiled_ok:
            restore_tile_order(addr)
    if not tiled_ok:
        # Leave tags so Super+F can retry; do not bring the bar back over a float.
        return
    restore_window_chrome(addr)
    tag_window(addr, "-x1fold-was-tiled")
    tag_window(addr, "-x1fold-clamshell-fs")
    FS_LAYOUT_PATH.unlink(missing_ok=True)


def enter_clamshell_fs(state: dict, client: dict) -> None:
    addr = str(client.get("address") or "")
    if not addr:
        return
    try:
        mon = pick_monitor(state)
    except SystemExit:
        return
    x, y, w, h = usable_rect(mon, state)
    if is_clamshell_fs(client) and usable_geometry_ok(client, x, y, w, h):
        return
    placing_begin()
    try:
        if not client.get("floating"):
            save_tile_layout(client)
            tag_window(addr, "+x1fold-was-tiled")
        # Tag first so the no-border / no-anim rule applies for the place.
        tag_window(addr, "+x1fold-clamshell-fs")
        float_to_usable_half(client, state, client_fullscreen=True)
    finally:
        placing_end()


def exit_clamshell_fs(client: dict) -> None:
    # Freeze layout animation so un-float, dwindle split, and bar exclusive
    # zone apply as one cut instead of a visible window dance.
    anims = animations_enabled()
    if anims:
        set_animations_enabled(False)
    placing_begin()
    try:
        restore_tiled_after_clamshell_fs(client)
    finally:
        placing_end()
    sync_bar(load_state())
    if anims:
        wait_bar_unparked()
        set_animations_enabled(True)


def constrain_fullscreen(state: dict, address: str | None = None) -> None:
    """In clamshell, keep client-fullscreen apps in the reserved usable half.

    Covering-fullscreen uses the whole OLED. Maximize keeps gaps/borders and
    Hyprland will not move/resize a maximized window. Super+F therefore floats
    the window onto the visible half directly (no covering flash). YouTube
    still requests covering; that is remapped the same way. Tiled windows get
    +x1fold-was-tiled so exit can tile them back.
    """
    clamshell = bool(state.get("clamshell"))
    want = str(address or "").lower().replace("address:", "")
    for client in hypr_clients():
        addr = str(client.get("address") or "")
        if not addr:
            continue
        if want and addr.lower().replace("address:", "") != want:
            continue
        if is_screensaver(client):
            continue
        internal = int(client.get("fullscreen") or 0)
        client_fs = int(client.get("fullscreenClient") or 0)
        tags = client_tags(client)
        if clamshell and (internal == 2 or (internal == 1 and client_fs == 2)):
            enter_clamshell_fs(state, client)
        elif (not clamshell) and (
            "x1fold-clamshell-fs" in tags
            or (internal == 1 and client_fs == 2)
            or (bool(client.get("floating")) and client_fs == 2)
        ):
            exit_clamshell_fs(client)
            dispatch_fullscreen_state(addr, 2, 2)


def cmd_fullscreen(state: dict, token: str, address: str | None = None) -> int:
    client = _client_by_addr(address) if address else hypr_active_client()
    if not client:
        fail("no window to fullscreen")
    tagged = is_clamshell_fs(client)
    if token in {"toggle", ""}:
        if tagged:
            exit_clamshell_fs(client)
        else:
            enter_clamshell_fs(state, client)
    elif token in {"off", "exit", "unset", "0"}:
        if tagged:
            exit_clamshell_fs(client)
    else:
        enter_clamshell_fs(state, client)
    sync_bar(state)
    return 0


def cmd_constrain_fullscreen(state: dict, address: str | None = None) -> int:
    constrain_fullscreen(state, address)
    sync_bar(state)
    return 0


def cmd_constrain_screensaver(state: dict, address: str | None = None) -> int:
    constrain_screensaver(state, address)
    sync_bar(state)
    return 0


def reset_ss_submap() -> None:
    eval_lua('hl.dispatch(hl.dsp.submap("reset"))')


def cmd_dismiss_screensaver(state: dict) -> int:
    """Unpark the bar, wait for exclusive-zone reflow, then close the saver.

    Closing first leaves tiled windows full-bleed for a frame, then the bar
    exclusive zone shrinks them. Reveal the bar while the saver still covers
    that reflow.
    """
    reset_ss_submap()
    if not screensaver_running() and not BAR_HIDDEN_MARKER.exists():
        restore_cursor_after_screensaver()
        sync_bar(state)
        return 0
    lock_path = STATE_DIR / "ss-dismiss.lock"
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with lock_path.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if not screensaver_running() and not BAR_HIDDEN_MARKER.exists():
            restore_cursor_after_screensaver()
            sync_bar(load_state())
            return 0
        anims = animations_enabled()
        if anims:
            set_animations_enabled(False)
        try:
            force_unpark_bar()
            wait_bar_unparked()
            close_screensaver_windows()
            restore_cursor_after_screensaver()
            wait_screensaver_gone()
        finally:
            sync_bar(load_state())
            if anims:
                set_animations_enabled(True)
    return 0


def cmd_sync_bar(state: dict) -> int:
    hidden = sync_bar(state)
    print("hidden" if hidden else "shown")
    return 0


def cmd_cursor(state: dict, token: str) -> int:
    if token in {"hide", "off", "true", "1"}:
        hide_cursor_for_screensaver()
    else:
        restore_cursor_after_screensaver()
        sync_bar(state)
    return 0


def announce(state: dict, bottom: int | None = None) -> None:
    # The Omarchy OSD sits on the bottom edge. In clamshell that is under the
    # keyboard, and a desktop notification would stack there too as a second
    # window. Stay silent for clamshell; the screen change is the feedback.
    if state.get("clamshell"):
        return
    info = ORIENTATIONS[int(state["transform"]) % 4]
    parts = [info["label"]]
    if state["autorotate"]:
        parts.append("auto-rotate")
    if state.get("osk"):
        parts.append("on-screen keyboard")
    osd(" · ".join(parts), "󰁑")


def parse_transform(token: str, current: int) -> int:
    key = token.strip().lower()
    if key == "cycle":
        return (current + 1) % 4
    if key not in NAME_TO_TRANSFORM:
        fail(f"unknown orientation: {token}")
    return NAME_TO_TRANSFORM[key]


def parse_bool(token: str, current: bool) -> bool:
    key = token.strip().lower()
    if key in {"on", "true", "1", "enable", "enabled"}:
        return True
    if key in {"off", "false", "0", "disable", "disabled"}:
        return False
    if key in {"toggle"}:
        return not current
    fail(f"expected on|off|toggle, got {token}")


def status_payload(state: dict) -> dict:
    mon = None
    try:
        mon = pick_monitor(state)
    except SystemExit:
        pass
    transform = int(state["transform"]) % 4
    info = ORIENTATIONS[transform]
    payload = {
        "plugin": PLUGIN_ID,
        "transform": transform,
        "degrees": info["degrees"],
        "orientation": info["name"],
        "label": info["label"],
        "portrait": is_portrait(transform),
        "clamshell": bool(state["clamshell"]),
        "autorotate": bool(state["autorotate"]),
        "autoclamshell": bool(state["autoclamshell"]),
        "cover_ratio": float(state["cover_ratio"]),
        "overlap_px": int(state["overlap_px"]),
        "osk": bool(state.get("osk")),
        "icon": "󰌌" if state["clamshell"] else ("󰁞" if is_portrait(transform) else "󰹑"),
    }
    if mon:
        lw, lh = logical_size(mon, transform)
        bottom = reserved_bottom(
            mon, transform, bool(state["clamshell"]), float(state["cover_ratio"]), int(state["overlap_px"])
        )
        payload.update(
            {
                "monitor": mon.get("name"),
                "description": mon.get("description"),
                "logical_width": lw,
                "logical_height": lh,
                "reserved_bottom": bottom,
                "hypr_transform": mon.get("transform"),
                "hypr_reserved": mon.get("reserved"),
            }
        )
    return payload


def read_sysfs_int(path: Path) -> int | None:
    try:
        return int(path.read_text().strip())
    except (OSError, ValueError):
        return None


def read_sysfs_float(path: Path) -> float | None:
    try:
        return float(path.read_text().strip())
    except (OSError, ValueError):
        return None


def iio_devices() -> dict[str, list[Path]]:
    root = Path("/sys/bus/iio/devices")
    found: dict[str, list[Path]] = {"accel": [], "hinge": []}
    if not root.exists():
        return found
    for dev in sorted(root.glob("iio:device*")):
        try:
            name = (dev / "name").read_text().strip()
        except OSError:
            continue
        if name == "accel_3d":
            found["accel"].append(dev)
        elif name == "hinge":
            found["hinge"].append(dev)
    return found


def read_accel_g(dev: Path) -> tuple[float, float, float] | None:
    scale = read_sysfs_float(dev / "in_accel_scale") or 1.0
    x = read_sysfs_int(dev / "in_accel_x_raw")
    y = read_sysfs_int(dev / "in_accel_y_raw")
    z = read_sysfs_int(dev / "in_accel_z_raw")
    if None in (x, y, z):
        return None
    return x * scale, y * scale, z * scale


def orientation_from_accel() -> int | None:
    devices = iio_devices()["accel"]
    samples = [s for s in (read_accel_g(dev) for dev in devices) if s]
    if not samples:
        return None
    if len(samples) == 2:
        a, b = samples
        sample = a if abs(a[2]) <= abs(b[2]) else b
        if abs(a[2] - b[2]) < 1.5:
            sample = tuple((a[i] + b[i]) / 2 for i in range(3))  # type: ignore[assignment]
    else:
        sample = samples[0]
    axes = {"x": sample[0], "y": sample[1], "z": sample[2]}
    axis, value = max(axes.items(), key=lambda item: abs(item[1]))
    second = sorted(abs(v) for v in axes.values())[-2]
    if abs(value) < 6.0 or abs(value) < second * 1.25:
        return None
    if axis == "z":
        return None
    sign = 1 if value >= 0 else -1
    return ACCEL_MAP.get((axis, sign))


def hinge_degrees() -> dict[str, float]:
    devices = iio_devices()["hinge"]
    out: dict[str, float] = {}
    if not devices:
        return out
    dev = devices[0]
    scale = read_sysfs_float(dev / "in_angl_scale") or 1.0
    to_deg = scale * (180.0 / 3.141592653589793)
    for idx, key in enumerate(("hinge", "screen", "keyboard")):
        raw = read_sysfs_int(dev / f"in_angl{idx}_raw")
        if raw is None:
            continue
        out[key] = raw * to_deg
    return out


def screensaver_running() -> bool:
    try:
        clients = json.loads(run(["hyprctl", "clients", "-j"], check=False).stdout or "[]")
    except (json.JSONDecodeError, FileNotFoundError):
        return False
    for client in clients:
        if str(client.get("class") or "") == SCREENSAVER_CLASS:
            return True
    return False


def monitor_matches(state: dict, mon: dict) -> bool:
    if int(mon.get("transform") or 0) != int(state["transform"]) % 4:
        return False
    reserved = mon.get("reserved") or [0, 0, 0, 0]
    got_bottom = int(reserved[3]) if len(reserved) > 3 else 0
    want = reserved_bottom(
        mon,
        int(state["transform"]),
        bool(state["clamshell"]),
        float(state["cover_ratio"]),
        int(state["overlap_px"]),
    )
    return abs(got_bottom - want) <= 4


WVKBD_BIN = HOME / ".local" / "bin" / "wvkbd-deskintl"
WVKBD_NAME = "wvkbd-deskintl"
WVKBD_HEIGHT = "520"
WVKBD_LANDSCAPE_HEIGHT = "400"
WVKBD_LAYERS = "full,special"


def osk_bin() -> Path:
    if WVKBD_BIN.is_file():
        return WVKBD_BIN
    found = shutil.which(WVKBD_NAME)
    return Path(found) if found else WVKBD_BIN


def osk_running() -> bool:
    proc = run(["pgrep", "-x", WVKBD_NAME], check=False)
    return proc.returncode == 0


def stop_osk_process() -> None:
    run(["pkill", "-x", WVKBD_NAME], check=False)
    for _ in range(20):
        if not osk_running():
            return
        time.sleep(0.05)


def hide_osk_surface() -> None:
    """Hide the layer without destroying the virtual keyboard.

    Killing wvkbd releases keys into the seat, which dismisses the
    screensaver. SIGUSR1 only tears down the overlay surface.
    """
    if not osk_running():
        return
    run(["pkill", "-USR1", "-x", WVKBD_NAME], check=False)


def show_osk_surface() -> None:
    if osk_running():
        run(["pkill", "-USR2", "-x", WVKBD_NAME], check=False)
        return
    set_osk_visible(True)


def ensure_osk_process() -> None:
    if osk_running():
        return
    binary = osk_bin()
    if not binary.is_file():
        fail(f"on-screen keyboard is not installed ({binary}). Run setup.sh from the plugin.")
    # Portrait OLED is 1600 logical; 520px is a usable deskintl height.
    subprocess.Popen(
        [
            str(binary),
            "-H",
            WVKBD_HEIGHT,
            "-L",
            WVKBD_LANDSCAPE_HEIGHT,
            "-l",
            WVKBD_LAYERS,
            "--landscape-layers",
            WVKBD_LAYERS,
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    for _ in range(20):
        time.sleep(0.15)
        if osk_running():
            return


def set_osk_visible(visible: bool) -> None:
    if visible:
        ensure_osk_process()
        if shutil.which("fcitx5-remote"):
            subprocess.run(["fcitx5-remote", "-c"], check=False, capture_output=True)
        return
    # Destroy the virtual keyboard so held keys cannot leak into the folio.
    stop_osk_process()
    if shutil.which("fcitx5-remote"):
        subprocess.run(["fcitx5-remote", "-o"], check=False, capture_output=True)


def set_osk(wanted: bool, persist: bool = True) -> None:
    set_osk_visible(wanted)
    if persist:
        state = load_state()
        state["osk"] = wanted
        save_state(state)


def cmd_status(state: dict) -> int:
    print(json.dumps(status_payload(state), indent=2))
    return 0


def cmd_rotate(state: dict, token: str) -> int:
    state["transform"] = parse_transform(token, int(state["transform"]))
    if state["clamshell"] and not is_portrait(state["transform"]):
        state["clamshell"] = False
    apply(state)
    return 0


def cmd_clamshell(state: dict, token: str) -> int:
    wanted = parse_bool(token, bool(state["clamshell"]))
    if wanted and not is_portrait(int(state["transform"])):
        state["transform"] = 0
    state["clamshell"] = wanted
    apply(state)
    return 0


def cmd_flag(state: dict, key: str, token: str) -> int:
    state[key] = parse_bool(token, bool(state[key]))
    save_state(state)
    announce(state)
    return 0


def cmd_cover_ratio(state: dict, token: str) -> int:
    try:
        ratio = float(token)
    except ValueError:
        fail(f"cover-ratio must be a number, got {token}")
    state["cover_ratio"] = min(0.70, max(0.35, ratio))
    apply(state)
    return 0


def cmd_overlap(state: dict, token: str) -> int:
    try:
        overlap = int(float(token))
    except ValueError:
        fail(f"overlap must be a number of pixels, got {token}")
    overlap = int(round(overlap / 5.0) * 5)
    state["overlap_px"] = min(50, max(-50, overlap))
    apply(state)
    return 0


def cmd_osk(state: dict, token: str) -> int:
    key = token.strip().lower()
    if key == "park":
        hide_osk_surface()
        return 0
    if key in {"unpark", "restore"}:
        if state.get("osk") and not state.get("clamshell") and not screensaver_running():
            show_osk_surface()
        return 0
    wanted = parse_bool(token, bool(state.get("osk")))
    if wanted and state["clamshell"]:
        fail("on-screen keyboard is hidden while clamshell is on")
    set_osk(wanted)
    state = load_state()
    announce(state)
    return 0


def cmd_tablet(state: dict) -> int:
    state["clamshell"] = False
    apply(state)
    return 0


def cmd_daemon(_state: dict) -> int:
    pending_transform: int | None = None
    pending_since = 0.0
    last_apply = 0.0
    resume_until = 0.0
    saw_screensaver = False
    while True:
        now = time.monotonic()
        saver = screensaver_running()
        if saver:
            if not saw_screensaver:
                try:
                    hide_osk_surface()
                except SystemExit:
                    pass
            saw_screensaver = True
            pending_transform = None
            time.sleep(0.35)
            continue
        if saw_screensaver:
            saw_screensaver = False
            resume_until = now + 4.0
            try:
                with locked_state() as state:
                    apply(state, quiet=True)
                last_apply = time.monotonic()
            except SystemExit:
                pass

        try:
            with locked_state() as state:
                now = time.monotonic()
                changed = False
                if state.get("autorotate") and now >= resume_until:
                    guessed = orientation_from_accel()
                    current = int(state["transform"])
                    if guessed is None or guessed == current:
                        pending_transform = None
                    elif guessed != pending_transform:
                        pending_transform = guessed
                        pending_since = now
                    elif now - pending_since >= 1.2:
                        if not (state["clamshell"] and not is_portrait(guessed)):
                            state["transform"] = guessed
                            changed = True
                        pending_transform = None

                if state.get("autoclamshell"):
                    hinge = hinge_degrees()
                    angle = hinge.get("hinge")
                    if angle is not None and angle != 0:
                        folded = 70.0 <= angle <= 140.0
                        if folded and is_portrait(int(state["transform"])) and not state["clamshell"]:
                            state["clamshell"] = True
                            changed = True
                        elif (not folded) and state["clamshell"] and angle < 30:
                            state["clamshell"] = False
                            changed = True

                if not changed and now - last_apply > 0.8:
                    try:
                        mon = pick_monitor(state)
                        if not monitor_matches(state, mon):
                            changed = True
                    except SystemExit:
                        pass

                if changed and now - last_apply > 0.35:
                    apply(state, quiet=True)
                    last_apply = now
        except SystemExit:
            pass

        time.sleep(0.35)


def usage() -> str:
    return __doc__.strip()


def main(argv: list[str]) -> int:
    args = argv[1:]
    if not args or args[0] in {"-h", "--help", "help"}:
        print(usage())
        return 0
    cmd = args[0]
    if cmd == "status":
        return cmd_status(load_state())
    if cmd == "rotate":
        if len(args) < 2:
            fail("rotate needs an orientation")
        return run_locked(cmd_rotate, args[1])
    if cmd == "clamshell":
        if len(args) < 2:
            fail("clamshell needs on|off|toggle")
        return run_locked(cmd_clamshell, args[1])
    if cmd == "autorotate":
        if len(args) < 2:
            fail("autorotate needs on|off|toggle")
        return run_locked(cmd_flag, "autorotate", args[1])
    if cmd == "autoclamshell":
        if len(args) < 2:
            fail("autoclamshell needs on|off|toggle")
        return run_locked(cmd_flag, "autoclamshell", args[1])
    if cmd == "osk":
        if len(args) < 2:
            fail("osk needs on|off|toggle")
        return run_locked(cmd_osk, args[1])
    if cmd == "cover-ratio":
        if len(args) < 2:
            fail("cover-ratio needs a number")
        return run_locked(cmd_cover_ratio, args[1])
    if cmd == "overlap":
        if len(args) < 2:
            fail("overlap needs a pixel count")
        return run_locked(cmd_overlap, args[1])
    if cmd == "tablet":
        return run_locked(cmd_tablet)
    if cmd == "apply":
        def _apply(state: dict) -> int:
            apply(state, quiet=True)
            if "--notify" in args[1:]:
                announce(state)
            return 0
        return run_locked(_apply)
    if cmd == "constrain-fullscreen":
        return run_locked(cmd_constrain_fullscreen, args[1] if len(args) > 1 else None)
    if cmd == "fullscreen":
        return run_locked(
            cmd_fullscreen,
            args[1] if len(args) > 1 else "toggle",
            args[2] if len(args) > 2 else None,
        )
    if cmd == "constrain-screensaver":
        return run_locked(cmd_constrain_screensaver, args[1] if len(args) > 1 else None)
    if cmd == "dismiss-screensaver":
        return run_locked(cmd_dismiss_screensaver)
    if cmd == "sync-bar":
        return run_locked(cmd_sync_bar)
    if cmd == "cursor":
        if len(args) < 2:
            fail("cursor needs hide|show")
        return run_locked(cmd_cursor, args[1])
    if cmd == "daemon":
        return cmd_daemon({})
    fail(f"unknown command: {cmd}\n{usage()}")


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv))
    except KeyboardInterrupt:
        raise SystemExit(130)
