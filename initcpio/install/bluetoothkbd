#!/bin/bash
# mkinitcpio install hook: Bluetooth HID in the initramfs so a paired
# keyboard can type the LUKS passphrase. Adapted from mkinitcpio-bluetooth.

build() {
	local core="^root:.*|^systemd-.*"
	local udev="^tty:.*|^uucp:.*|^kmem:.|^input:.*|^video:.*|^audio:.*|^lp:.*|^disk:.*|^optical:.*|^storage:.*|^dbus:.*"
	local target
	for target in /etc/{group,passwd,shadow}; do
		add_file "$target"
		sed -i -r -e "/${core}|${udev}/!d" "$BUILDROOT/$target"
	done

	# uhid + cmac are required for BLE HOGP (this folio keyboard). Without
	# uhid, bluetoothd logs "input-hog profile accept failed" and no
	# /dev/input node appears at the LUKS prompt.
	local mod
	for mod in bluetooth bnep hidp btusb btintel btrtl btmtk rfcomm usbhid uhid cmac hid-multitouch; do
		add_module "$mod"
	done

	# btintel picks the CNVi blob at runtime from chip OTP (ibt-VVVV-PPPP.sfi).
	# modinfo only lists ancient ibt-11/ibt-12 files, so add_module will not
	# pull what this adapter actually loads. Missing firmware in the initramfs
	# makes hci0 fail with -ENOENT during modconf, and the kernel will not
	# retry after switch-root — Bluetooth stays dead for the whole boot.
	if ! add_firmware intel/ibt-0040-0041.sfi intel/ibt-0040-0041.ddc; then
		error "bluetoothkbd: missing intel/ibt-0040-0041 firmware"
		return 1
	fi
	local fw
	for fw in /usr/lib/firmware/intel/ibt-0040-*.sfi* /usr/lib/firmware/intel/ibt-0040-*.ddc*; do
		[[ -e $fw ]] || continue
		add_file "$fw"
	done

	for libnssfile in /usr/lib/libnss_files*; do
		add_file "$libnssfile"
	done
	for libnslfile in /usr/lib/libnsl*; do
		add_file "$libnslfile"
	done

	add_dir /etc/dbus-1/
	add_dir /etc/dbus-1/system.d/
	add_dir /run/dbus/
	add_file /usr/share/dbus-1/system.conf
	add_binary /usr/bin/dbus-daemon
	add_file /usr/lib/sysusers.d/dbus.conf
	add_file /usr/lib/tmpfiles.d/dbus.conf
	add_symlink /var/lib/dbus/machine-id /etc/machine-id

	add_file /etc/bluetooth/main.conf
	add_binary /usr/lib/bluetooth/bluetoothd
	add_file /usr/share/dbus-1/system.d/bluetooth.conf
	add_file /usr/share/dbus-1/system-services/org.bluez.service
	add_full_dir /var/lib/bluetooth
	add_binary /usr/bin/bluetoothctl

	add_dir /run/sdp/
	add_symlink /var/run /run

	add_runscript
}

help() {
	cat <<HELPEOF
Start bluetoothd in the initramfs so a paired Bluetooth keyboard can
unlock LUKS. Place this hook after keyboard and before encrypt.
HELPEOF
}
