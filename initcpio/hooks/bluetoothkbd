#!/usr/bin/ash
# Runtime hook: bring up dbus + bluetoothd and reconnect the folio BLE
# keyboard before the encrypt prompt. This keyboard is HOGP (BLE HID),
# which needs /dev/uhid — classic hidp is not enough.
#
# After a successful passphrase, cryptsetup waits for udev to create
# /dev/mapper/root. systemd-udevd plus a system dbus + HOGP input events
# can deadlock that wait, so the splash hangs forever. Disable libdevmapper
# udev sync for the rest of the initramfs (plymouthd inherits this export)
# and never kill dbus-daemon — udev cleanup still needs it.

ply_msg() {
	msg "$1"
	if command -v plymouth >/dev/null && plymouth --ping 2>/dev/null; then
		plymouth display-message --text="$1" || true
	fi
}

ensure_uhid() {
	modprobe -q uhid
	modprobe -q cmac
	[ -e /dev/uhid ] && return 0
	if [ -e /sys/class/misc/uhid/dev ]; then
		majmin=$(cat /sys/class/misc/uhid/dev)
		mknod /dev/uhid c "${majmin%:*}" "${majmin#*:}" 2>/dev/null || true
	fi
}

usb_folio_present() {
	local f
	for f in /sys/class/input/*/name; do
		[ -f "$f" ] || continue
		grep -q 'ThinkPad Bluetooth TrackPoint Keyboard - USB' "$f" && return 0
	done
	return 1
}

ble_keyboard_ready() {
	local f
	for f in /sys/devices/virtual/misc/uhid/*/input/*/name; do
		[ -f "$f" ] || continue
		return 0
	done
	return 1
}

connect_paired_hid() {
	local info addr
	for info in /var/lib/bluetooth/*/*/info; do
		[ -f "$info" ] || continue
		grep -q '00001812-0000-1000-8000-00805f9b34fb' "$info" || continue
		grep -q 'Trusted=true' "$info" || continue
		addr=${info%/*}
		addr=${addr##*/}
		msg ":: Connecting Bluetooth keyboard $addr..."
		bluetoothctl connect "$addr" >/dev/null 2>&1 || true
	done
}

keyboard_connected() {
	ply_msg "Bluetooth keyboard connected"
	# Leave the status on the splash through the passphrase prompt.
	sleep 1
}

drain_udev() {
	if command -v udevadm >/dev/null; then
		udevadm settle --timeout=5 2>/dev/null || true
	fi
}

run_earlyhook() {
	# Must be exported before plymouthd starts (plymouth run_hook).
	# plymouth ask-for-password then runs cryptsetup in plymouthd, which
	# inherits this so it will mknod /dev/mapper/root itself.
	export DM_DISABLE_UDEV=1
	mkdir -p /usr/local/bin
	if [ ! -e /usr/local/bin/cryptsetup ]; then
		printf '%s\n' '#!/bin/sh' 'export DM_DISABLE_UDEV=1' 'exec /usr/bin/cryptsetup "$@"' > /usr/local/bin/cryptsetup
		chmod 755 /usr/local/bin/cryptsetup
	fi

	msg ":: Activating dbus..."
	mkdir -p /run/dbus /run/sdp
	ensure_uhid
	/usr/bin/dbus-daemon --system --syslog-only
}

run_hook() {
	msg ":: Activating bluetoothd..."
	/usr/lib/bluetooth/bluetoothd &

	# USB-C takes over this folio and BLE goes idle. Don't delay LUKS
	# when the user already has a working USB keyboard.
	if usb_folio_present; then
		ply_msg "USB keyboard connected"
		drain_udev
		return 0
	fi

	ply_msg "Waiting for Bluetooth keyboard..."

	n=0
	while [ "$n" -lt 10 ]; do
		if ble_keyboard_ready; then
			keyboard_connected
			drain_udev
			return 0
		fi
		if bluetoothctl show 2>/dev/null | grep -q 'Powered: yes'; then
			break
		fi
		bluetoothctl power on >/dev/null 2>&1 || true
		sleep 1
		n=$((n + 1))
	done

	connect_paired_hid

	n=0
	while [ "$n" -lt 12 ]; do
		if ble_keyboard_ready; then
			keyboard_connected
			drain_udev
			return 0
		fi
		left=$((12 - n))
		ply_msg "Waiting for Bluetooth keyboard (${left}s)"
		sleep 1
		n=$((n + 1))
	done
	ply_msg "Bluetooth keyboard not connected"
	sleep 2
	drain_udev
}

run_cleanuphook() {
	if command -v plymouth >/dev/null && plymouth --ping 2>/dev/null; then
		plymouth hide-message || true
	fi
	# Do not kill dbus-daemon: systemd-udevd may be using that socket.
	# switch_root reaps leftover bluetoothd.
	killall bluetoothd 2>/dev/null || true
	drain_udev
}
