#!/usr/bin/ash
# Runtime hook: bring up a PRIVATE dbus + bluetoothd and reconnect the
# folio BLE keyboard before the encrypt prompt. This keyboard is HOGP
# (BLE HID), which needs /dev/uhid — classic hidp is not enough.
#
# Do not use the system bus. systemd-udevd will attach to
# /run/dbus/system_bus_socket and then `udevadm control --exit` never
# returns after HOGP input events — splash hangs after a good passphrase
# even though LUKS opened /dev/mapper/root. The "Unable to resume from
# device '/dev/mapper/root'" line is the kernel skipping hibernation
# (no image); it is not the hang.

BTBUS_DIR=/run/btbus
BTBUS_SOCK=$BTBUS_DIR/bus
BTBUS_CONF=$BTBUS_DIR/dbus.conf

ply_msg() {
	msg "$1"
	if command -v plymouth >/dev/null && plymouth --ping 2>/dev/null; then
		plymouth display-message --text="$1" || true
	fi
}

ensure_uhid() {
	modprobe -q uhid
	modprobe -q cmac
	[ -e /dev/uhid ] && return 0
	if [ -e /sys/class/misc/uhid/dev ]; then
		majmin=$(cat /sys/class/misc/uhid/dev)
		mknod /dev/uhid c "${majmin%:*}" "${majmin#*:}" 2>/dev/null || true
	fi
}

usb_folio_present() {
	local f
	for f in /sys/class/input/*/name; do
		[ -f "$f" ] || continue
		grep -q 'ThinkPad Bluetooth TrackPoint Keyboard - USB' "$f" && return 0
	done
	return 1
}

ble_keyboard_ready() {
	local f
	for f in /sys/devices/virtual/misc/uhid/*/input/*/name; do
		[ -f "$f" ] || continue
		return 0
	done
	return 1
}

connect_paired_hid() {
	local info addr
	for info in /var/lib/bluetooth/*/*/info; do
		[ -f "$info" ] || continue
		grep -q '00001812-0000-1000-8000-00805f9b34fb' "$info" || continue
		grep -q 'Trusted=true' "$info" || continue
		addr=${info%/*}
		addr=${addr##*/}
		msg ":: Connecting Bluetooth keyboard $addr..."
		bluetoothctl connect "$addr" >/dev/null 2>&1 || true
	done
}

keyboard_connected() {
	ply_msg "Bluetooth keyboard connected"
	sleep 1
}

drain_udev() {
	if command -v udevadm >/dev/null; then
		udevadm settle --timeout=5 2>/dev/null || true
	fi
}

stop_bluetooth() {
	if [ -f "$BTBUS_DIR/bluetoothd.pid" ]; then
		kill "$(cat "$BTBUS_DIR/bluetoothd.pid")" 2>/dev/null || true
	fi
	killall bluetoothd 2>/dev/null || true
	if [ -f "$BTBUS_DIR/dbus.pid" ]; then
		kill "$(cat "$BTBUS_DIR/dbus.pid")" 2>/dev/null || true
	fi
}

# Once LUKS has created the mapper, the passphrase is done — tear BlueZ
# down so udev is idle before resume + `udevadm control --exit`.
stop_bluetooth_after_unlock() {
	n=0
	while [ "$n" -lt 120 ]; do
		if [ -b /dev/mapper/root ]; then
			sleep 2
			stop_bluetooth
			drain_udev
			return 0
		fi
		sleep 1
		n=$((n + 1))
	done
}

start_private_bus() {
	mkdir -p "$BTBUS_DIR" /run/sdp
	cat > "$BTBUS_CONF" << 'EOF'
<busconfig>
  <type>system</type>
  <keep_umask/>
  <listen>unix:path=/run/btbus/bus</listen>
  <auth>EXTERNAL</auth>
  <allow_anonymous/>
  <policy context="default">
    <allow send_destination="*"/>
    <allow eavesdrop="true"/>
    <allow own="*"/>
    <allow user="*"/>
  </policy>
</busconfig>
EOF
	/usr/bin/dbus-daemon --config-file="$BTBUS_CONF" --nofork --nopidfile &
	echo $! > "$BTBUS_DIR/dbus.pid"
	export DBUS_SYSTEM_BUS_ADDRESS="unix:path=$BTBUS_SOCK"
	n=0
	while [ ! -S "$BTBUS_SOCK" ] && [ "$n" -lt 20 ]; do
		sleep 1
		n=$((n + 1))
	done
}

run_earlyhook() {
	# Must be exported before plymouthd starts (plymouth run_hook).
	export DM_DISABLE_UDEV=1
	mkdir -p /usr/local/bin
	if [ ! -e /usr/local/bin/cryptsetup ]; then
		printf '%s\n' '#!/bin/sh' 'export DM_DISABLE_UDEV=1' 'exec /usr/bin/cryptsetup "$@"' > /usr/local/bin/cryptsetup
		chmod 755 /usr/local/bin/cryptsetup
	fi

	ensure_uhid
	msg ":: Activating private bluetooth dbus..."
	start_private_bus
}

run_hook() {
	export DBUS_SYSTEM_BUS_ADDRESS="unix:path=$BTBUS_SOCK"
	msg ":: Activating bluetoothd..."
	/usr/lib/bluetooth/bluetoothd &
	echo $! > "$BTBUS_DIR/bluetoothd.pid"

	stop_bluetooth_after_unlock &

	if usb_folio_present; then
		ply_msg "USB keyboard connected"
		drain_udev
		return 0
	fi

	ply_msg "Waiting for Bluetooth keyboard..."

	n=0
	while [ "$n" -lt 10 ]; do
		if ble_keyboard_ready; then
			keyboard_connected
			drain_udev
			return 0
		fi
		if bluetoothctl show 2>/dev/null | grep -q 'Powered: yes'; then
			break
		fi
		bluetoothctl power on >/dev/null 2>&1 || true
		sleep 1
		n=$((n + 1))
	done

	connect_paired_hid

	n=0
	while [ "$n" -lt 12 ]; do
		if ble_keyboard_ready; then
			keyboard_connected
			drain_udev
			return 0
		fi
		left=$((12 - n))
		ply_msg "Waiting for Bluetooth keyboard (${left}s)"
		sleep 1
		n=$((n + 1))
	done
	ply_msg "Bluetooth keyboard not connected"
	sleep 2
	drain_udev
}

run_latehook() {
	stop_bluetooth
	drain_udev
}

run_cleanuphook() {
	stop_bluetooth
	# Never plymouth --ping here: plymouthd can be wedged after resume
	# skip, and the ping would hang PID 1 until you reboot.
}
