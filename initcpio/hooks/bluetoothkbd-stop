#!/usr/bin/ash
# Immediately after encrypt. Fully tear down initramfs BlueZ so Plymouth
# and udevadm control --exit are not blocked by HOGP.
#
# Do not `rfkill block`: systemd-rfkill persists that under
# /var/lib/systemd/rfkill and Omarchy would come back with Bluetooth off.
# Unbind btusb instead; switch-root's udevd coldplug brings the adapter up
# for the real bluetoothd.

BTBUS_DIR=/run/btbus
BTBUS_SOCK=$BTBUS_DIR/bus

run_hook() {
	if [ -S "$BTBUS_SOCK" ]; then
		export DBUS_SYSTEM_BUS_ADDRESS="unix:path=$BTBUS_SOCK"
		for info in /var/lib/bluetooth/*/*/info; do
			[ -f "$info" ] || continue
			grep -q '00001812-0000-1000-8000-00805f9b34fb' "$info" || continue
			addr=${info%/*}
			addr=${addr##*/}
			bluetoothctl disconnect "$addr" >/dev/null 2>&1 || true
		done
		bluetoothctl power off >/dev/null 2>&1 || true
	fi

	if [ -f "$BTBUS_DIR/bluetoothd.pid" ]; then
		kill "$(cat "$BTBUS_DIR/bluetoothd.pid")" 2>/dev/null || true
	fi
	killall bluetoothd 2>/dev/null || true
	sleep 1
	if [ -f "$BTBUS_DIR/bluetoothd.pid" ]; then
		kill -9 "$(cat "$BTBUS_DIR/bluetoothd.pid")" 2>/dev/null || true
	fi
	killall -9 bluetoothd 2>/dev/null || true

	if [ -f "$BTBUS_DIR/dbus.pid" ]; then
		kill "$(cat "$BTBUS_DIR/dbus.pid")" 2>/dev/null || true
		sleep 1
		kill -9 "$(cat "$BTBUS_DIR/dbus.pid")" 2>/dev/null || true
	fi

	# Drop the kernel HCI node without touching rfkill.
	if [ -d /sys/bus/usb/drivers/btusb ]; then
		for iface in /sys/bus/usb/drivers/btusb/*:*; do
			[ -e "$iface" ] || continue
			echo "${iface##*/}" >/sys/bus/usb/drivers/btusb/unbind 2>/dev/null || true
		done
	fi

	modprobe -r uhid 2>/dev/null || true
	modprobe -r hidp 2>/dev/null || true

	if command -v udevadm >/dev/null; then
		udevadm settle --timeout=5 2>/dev/null || true
	fi
}
