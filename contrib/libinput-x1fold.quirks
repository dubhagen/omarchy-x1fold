# ThinkPad X1 Fold 16 TrackPoint Keyboard
#   Bluetooth  17ef:613e  HID name X1FKeyboard
#   USB-C      17ef:6142  Primax "... Keyboard - USB"
#
# Generic bluetooth keyboards are AttrKeyboardIntegration=external, so
# disable-while-typing never sees them. Mark these keyboards internal.
# The touchpad is marked internal by the hwdb (ID_INPUT_TOUCHPAD_INTEGRATION).
# There is no AttrTouchpadIntegration key: an unknown key makes libinput
# reject every quirk file, including the ones it ships.

[Lenovo X1 Fold TrackPoint Keyboard Bluetooth]
MatchUdevType=keyboard
MatchBus=bluetooth
MatchVendor=0x17EF
MatchProduct=0x613E
AttrKeyboardIntegration=internal

[Lenovo X1 Fold TrackPoint Keyboard USB]
MatchUdevType=keyboard
MatchBus=usb
MatchVendor=0x17EF
MatchProduct=0x6142
AttrKeyboardIntegration=internal
