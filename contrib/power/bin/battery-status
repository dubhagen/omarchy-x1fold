#!/usr/bin/env bash
# Pack totals for a machine with more than one power-supply battery.
#
# omarchy-battery-status stops at the first cell. The power panel's icon
# already follows UPower's DisplayDevice, but its size, rate, and time come
# from that script. With a single cell this execs the stock tool unchanged.
# With two or more, the --shell keys stay the stock ones: cycles, threshold,
# and holding state are kept, and percentage, size, rate, and time are the pack.
set -uo pipefail

if [[ ${1:-} != --shell ]]; then
  exec omarchy-battery-status "$@"
fi

stock=$(omarchy-battery-status --shell) || exit $?
power_supply_path="${OMARCHY_POWER_SUPPLY_PATH:-/sys/class/power_supply}"

present=()
for bat in "$power_supply_path"/BAT*; do
  [[ -d $bat ]] || continue
  [[ -r $bat/present && $(<"$bat/present") == 1 ]] || continue
  present+=("$bat")
done
if (( ${#present[@]} < 2 )); then
  printf '%s\n' "$stock"
  exit 0
fi

info=$(upower -i /org/freedesktop/UPower/devices/DisplayDevice 2>/dev/null || true)
if ! grep -q 'present:[[:space:]]*yes' <<<"$info"; then
  printf '%s\n' "$stock"
  exit 0
fi

format_duration() {
  local minutes=$1
  if [[ -z $minutes ]] || (( minutes <= 0 )); then
    return
  elif (( minutes < 60 )); then
    omarchy-i18n battery.durationMinutes "$minutes"
  elif (( minutes % 60 == 0 )); then
    omarchy-i18n battery.durationHours "$(( minutes / 60 ))"
  else
    omarchy-i18n battery.durationHoursMinutes "$(( minutes / 60 ))" "$(( minutes % 60 ))"
  fi
}

percentage=$(awk '/percentage/ { printf "%d", $2; exit }' <<<"$info")
capacity=$(awk '/energy-full:/ { printf "%d", $2; exit }' <<<"$info")
energy=$(awk '/^ *energy:/ { print $2; exit }' <<<"$info")
energy_full=$(awk '/energy-full:/ { print $2; exit }' <<<"$info")
state=$(awk '/state/ { print $2; exit }' <<<"$info")

power_sum=0
have_sysfs=0
for bat in "${present[@]}"; do
  if [[ -r $bat/power_now ]]; then
    watts=$(awk -v microwatts="$(<"$bat/power_now")" 'BEGIN { v = microwatts / 1000000; if (v < 0) v = -v; print v }')
    power_sum=$(awk -v acc="$power_sum" -v add="$watts" 'BEGIN { print acc + add }')
    have_sysfs=1
  elif [[ -r $bat/current_now && -r $bat/voltage_now ]]; then
    watts=$(awk -v microamps="$(<"$bat/current_now")" -v microvolts="$(<"$bat/voltage_now")" \
      'BEGIN { v = microamps * microvolts / 1000000000000; if (v < 0) v = -v; print v }')
    power_sum=$(awk -v acc="$power_sum" -v add="$watts" 'BEGIN { print acc + add }')
    have_sysfs=1
  fi
done
if (( have_sysfs )); then
  power_rate_raw=$power_sum
else
  power_rate_raw=$(awk '/energy-rate/ { print $2; exit }' <<<"$info")
fi
power_rate=$(awk -v rate="${power_rate_raw:-0}" 'BEGIN {
  if (rate < 0) rate = -rate
  rounded = sprintf("%.1f", rate)
  sub(/\.0$/, "", rounded)
  print rounded
}')

threshold_line=$(awk -F '\t' '$1 == "threshold" { print $2; exit }' <<<"$stock")
limit=$(awk -v line="$threshold_line" 'BEGIN {
  n = split(line, parts, /[^0-9]+/)
  last = 100
  for (i = 1; i <= n; i++) if (parts[i] != "") last = parts[i]
  print last + 0
}')
minutes=$(awk \
  -v energy="$energy" -v full="$energy_full" -v rate="${power_rate_raw:-0}" \
  -v state="$state" -v limit="$limit" 'BEGIN {
  if (rate < 0) rate = -rate
  if (energy == "" || full == "" || rate <= 0.2) exit
  hours = state == "charging" ? (full * limit / 100 - energy) / rate : energy / rate
  if (hours <= 0) exit
  printf "%d", int(hours * 60 + 0.5)
}')
time_remaining=""
[[ -n ${minutes:-} ]] && time_remaining=$(format_duration "$minutes")

while IFS= read -r line; do
  [[ -n $line ]] || continue
  key=${line%%$'\t'*}
  case "$key" in
    percentage) printf 'percentage\t%s%%\n' "$percentage" ;;
    rate) printf 'rate\t%sW\n' "$power_rate" ;;
    size) printf 'size\t%sWh\n' "$capacity" ;;
    time) printf 'time\t%s\n' "$time_remaining" ;;
    *) printf '%s\n' "$line" ;;
  esac
done <<<"$stock"
